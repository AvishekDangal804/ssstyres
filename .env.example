# Copy these into Vercel: Project -> Settings -> Environment Variables.
# Without all three, the Dealer and Contact forms in PRODUCTION show a
# "please call or email us" message instead of pretending to submit.
# (Previews/local dev log the submission and show success.)

# Resend API key (https://resend.com) -- server-side only, never NEXT_PUBLIC_.
RESEND_API_KEY=

# Where submissions are emailed. Comma-separate for several recipients.
LEAD_TO_EMAIL=

# Sender. Must be on a domain verified in Resend, e.g.
# LEAD_FROM_EMAIL="SSS Website <website@ssswheels.com.au>"
LEAD_FROM_EMAIL=
